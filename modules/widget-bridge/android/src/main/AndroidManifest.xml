<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <receiver
        android:name=".AccountsGlanceWidgetReceiver"
        android:exported="false"
        android:label="Erebor Accounts">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/accounts_widget_info" />
    </receiver>

    <activity
        android:name=".AccountsWidgetConfigActivity"
        android:exported="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
      </intent-filter>
    </activity>

    <!-- New widget, added alongside the existing Accounts & Quick Add
         widget above; that receiver/activity pair is unchanged. -->
    <receiver
        android:name=".QuickAddGlanceWidgetReceiver"
        android:exported="false"
        android:label="Erebor Quick Add">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/quick_add_widget_info" />
    </receiver>

    <!-- Third widget, added alongside the two above; neither is touched. -->
    <receiver
        android:name=".CashFlowGlanceWidgetReceiver"
        android:exported="false"
        android:label="Erebor Cash Flow">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/cash_flow_widget_info" />
    </receiver>
  </application>
</manifest>
