{
  "expo": {
    "name": "Erebor Wealth Management",
    "slug": "spending-tracker-mobile",
    "version": "4.0.0",
    "scheme": "spendingtracker",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jsphemil.spendingtracker"
    },
    "android": {
      "package": "com.jsphemil.spendingtracker",
      "adaptiveIcon": {
        "backgroundColor": "#4c7dff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c1120",
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# R8 runs with optimization on from 3.1.1 (plugins/withR8Optimization.js).\n# The widget module is reached by the launcher and AppWidget framework, and\n# Glance/Compose resolve pieces of it reflectively, so keep it whole rather\n# than discover a stripped widget after upload.\n-keep class expo.modules.widgetbridge.** { *; }\n# Glance app widgets construct their receivers and state definitions by name.\n-keep class androidx.glance.appwidget.** { *; }\n# expo-notifications' receivers and services are started by the system.\n-keep class expo.modules.notifications.** { *; }"
          }
        }
      ],
      "./plugins/withAppShortcuts.js",
      "./plugins/withR8Optimization.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05d13497-4b5e-4488-b669-361a3769283f"
      },
      "dropboxAppKey": "m4qezyiagdh2nsi"
    },
    "owner": "jsphemil"
  }
}
